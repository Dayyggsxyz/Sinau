# Salin file ini menjadi .env.local lalu isi nilainya, kemudian restart `npm run dev`.
# PENTING: semua variabel VITE_* ikut masuk ke bundle browser dan bisa dilihat siapa pun.
# Jangan commit .env.local.

# ---------- Login Google ----------
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID > Web application.
# Tambahkan http://localhost:5173 ke "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Izinkan tombol "Lanjutkan tanpa akun" di halaman masuk (true/false). Matikan untuk produksi.
VITE_ALLOW_GUEST=true

# Opsional: URL backend. Jika diisi, credential Google dikirim ke POST {URL}/auth/google
# untuk diverifikasi server (respons: { "user": { "id", "email", "name", "picture" } }).
# Jika kosong, token hanya didekode di browser tanpa verifikasi.
VITE_API_BASE_URL=

# ---------- AI ----------
# 'mock' (jawaban contoh), 'anthropic', atau 'openai' (API kompatibel OpenAI: OpenAI, OpenRouter, Groq, dll.)
VITE_AI_PROVIDER=mock
VITE_AI_API_KEY=
# Kosongkan untuk memakai model bawaan provider.
VITE_AI_MODEL=
# Kosongkan untuk URL resmi provider. Isi dengan URL proxy milikmu (disarankan untuk produksi
# agar API key tidak ada di browser).
VITE_AI_BASE_URL=

# ---------- Unggah ----------
VITE_MAX_UPLOAD_MB=20
